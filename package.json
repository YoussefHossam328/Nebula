{
  "name": "nebula-mars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/manus-game-assets/restore.mjs && vite --host 0.0.0.0",
    "build": "node scripts/manus-game-assets/restore.mjs && node scripts/manus-game-sharing/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "refresh:nasa": "python3 scripts/refresh-nasa.py",
    "manus:build-source": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "lil-gui": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
